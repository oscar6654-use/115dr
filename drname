  let html='';
  if(q){
    const k=q.trim();
    const list=DATA.filter(d=>String(d.no)===k||d.name.includes(k)||d.dept.includes(k)||d.award.includes(k)||(d.note||'').includes(k));
    html=`<div class="grouphead"><h2>搜尋「${esc(k)}」</h2><span class="sub">${list.length} 筆</span></div>`+(list.length?list.map(d=>card(d)).join(''):'<div class="empty">查無此人，請確認姓名或序號</div>');
