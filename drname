  const j=e.target.closest('[data-jump]');if(j){const d=DATA.find(x=>x.no===+j.dataset.jump);go(d.g,d.no);return}
  const n=e.target.closest('.no');if(n&&q){const no=+n.querySelector('b').textContent;const d=DATA.find(x=>x.no===no);go(d.g,no);return}
  if(e.target.id==='fgo'||e.target.id==='fskip'){const c=DATA.find(d=>!(st[d.no]===2||st[d.no]===3));if(c){hist.push([c.no,st[c.no]||0]);st[c.no]=e.target.id==='fgo'?2:3;save();render();window.scrollTo(0,0)}return}
  if(e.target.id==='fundo'){const h=hist.pop();if(h){if(h[1])st[h[0]]=h[1];else delete st[h[0]];save();render()}return}
  if(e.target.id==='todo'){onlyTodo=!onlyTodo;render();return}
  if(e.target.id==='allq'){groups[cur].items.forEach(d=>{if(!st[d.no])st[d.no]=1});save();render();return}
});
$('#q').addEventListener('input',e=>{q=e.target.value.trim();render()});
$('#clr').onclick=()=>{q='';$('#q').value='';render()};
$('#prev').onclick=()=>go(cur-1);$('#next').onclick=()=>go(cur+1);
$('#mode').onclick=()=>{focus=!focus;try{localStorage.setItem(KEY+'-m',focus?'1':'0')}catch(e){}q='';$('#q').value='';render();window.scrollTo(0,0)};
$('#reset').onclick=()=>$('#mask').classList.add('show');
$('#no').onclick=()=>$('#mask').classList.remove('show');
$('#yes').onclick=()=>{st={};save();$('#mask').classList.remove('show');render()};
window.addEventListener('resize',setH);setH();render();
</script>
</body>
</html>
