  --navy:#15233f; --gold:#b8892b; --gold2:#f3e4bf;
  --ok:#2f7d4f; --okbg:#e2f2e7; --stage:#2c5aa0; --stagebg:#e3ecf9;
  --no:#b23b3b; --nobg:#f8e3e1;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0}
body{font-family:"Noto Sans TC",system-ui,sans-serif;background:var(--bg);color:var(--ink);font-size:17px}
header{position:sticky;top:0;z-index:20;background:var(--navy);color:#fff;padding:12px 16px 10px;box-shadow:0 2px 10px rgba(0,0,0,.18)}
.toprow{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
h1{font-family:"Noto Serif TC",serif;font-size:20px;margin:0;letter-spacing:.06em;font-weight:900}
h1 small{display:block;font-family:"Noto Sans TC";font-size:12px;font-weight:500;color:var(--gold2);letter-spacing:.12em;margin-bottom:2px}
.stats{margin-left:auto;display:flex;gap:6px;font-size:13px}
.stat{background:rgba(255,255,255,.1);border-radius:8px;padding:4px 9px;white-space:nowrap}
.stat b{font-size:16px;margin-left:3px}
.searchrow{display:flex;gap:8px;margin-top:10px}
#q{flex:1;font-size:18px;padding:10px 14px;border-radius:10px;border:0;background:#fff;color:var(--ink);min-width:0}
.btn{font:inherit;border:0;border-radius:10px;padding:10px 14px;font-weight:700;cursor:pointer;background:#fff;color:var(--navy)}
.btn.ghost{background:rgba(255,255,255,.12);color:#fff}
nav{position:sticky;top:var(--hh,118px);z-index:15;background:var(--bg);border-bottom:1px solid var(--line);padding:8px 10px;display:flex;gap:6px;overflow-x:auto;scrollbar-width:none}
nav::-webkit-scrollbar{display:none}
.chip{flex:0 0 auto;border:1.5px solid var(--line);background:var(--card);border-radius:999px;padding:7px 13px;font:inherit;font-size:15px;font-weight:500;color:var(--ink2);cursor:pointer;white-space:nowrap}
.chip .n{font-size:12px;color:var(--muted);margin-left:4px}
.chip.on{background:var(--navy);border-color:var(--navy);color:#fff}
.chip.on .n{color:var(--gold2)}
.chip.done{border-color:var(--ok)}
.chip.done::after{content:" ✓";color:var(--ok);font-weight:900}
.chip.on.done::after{color:#9fe0b6}
main{padding:12px 12px 120px;max-width:980px;margin:0 auto}
.grouphead{display:flex;align-items:baseline;gap:10px;margin:6px 4px 10px}
.grouphead h2{font-family:"Noto Serif TC",serif;margin:0;font-size:24px;color:var(--navy)}
.grouphead .sub{color:var(--muted);font-size:14px}
.grouphead .tools{margin-left:auto;display:flex;gap:6px}
.mini{font:inherit;font-size:14px;border:1.5px solid var(--line);background:var(--card);border-radius:8px;padding:6px 10px;cursor:pointer;color:var(--ink2)}
.mini.on{background:var(--gold2);border-color:var(--gold);color:var(--ink)}
.card{display:grid;grid-template-columns:64px 1fr auto;gap:4px 14px;align-items:center;background:var(--card);border:1.5px solid var(--line);border-left:6px solid var(--line);border-radius:14px;padding:12px 14px;margin-bottom:9px;position:relative}
.card.s1{border-left-color:var(--ok);background:linear-gradient(90deg,var(--okbg),var(--card) 40%)}
.card.s2{border-left-color:var(--stage);opacity:.62}
.card.s3{border-left-color:var(--no);background:linear-gradient(90deg,var(--nobg),var(--card) 40%)}
.card.focus{outline:3px solid var(--gold);outline-offset:2px}
.no{grid-row:span 2;width:56px;height:56px;border-radius:50%;background:var(--navy);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1}
.no small{font-size:10px;color:var(--gold2);margin-bottom:2px;letter-spacing:.1em}
.no b{font-size:22px;font-weight:900}
.pos{position:absolute;top:-8px;left:10px;font-size:11px;background:var(--gold);color:#fff;border-radius:6px;padding:1px 6px;font-weight:700}
.who{min-width:0}
.name{font-size:26px;font-weight:900;letter-spacing:.04em;line-height:1.15}
.name .proxy{font-size:15px;font-weight:700;color:#fff;background:#c46a1c;border-radius:6px;padding:2px 7px;margin-left:6px;vertical-align:4px;letter-spacing:0}
.meta{color:var(--ink2);font-size:15px;margin-top:2px}
.meta .rank{color:var(--gold);font-weight:700}
.tags{grid-column:2/4;display:flex;flex-wrap:wrap;gap:6px;margin-top:4px}
.tag{font-size:13.5px;border-radius:7px;padding:3px 8px;background:#efeadf;color:var(--ink2)}
.tag.seat{background:var(--navy);color:#fff;font-weight:700}
.tag.warn{background:#fdecc8;color:#7a4b00;font-weight:500}
.tag.rep{background:#ece4fb;color:#4b2f8a;font-weight:500;cursor:pointer}
.tag.tel{background:#e6f0ee;color:#1f5b4f}
.acts{display:flex;gap:6px;grid-row:1/2;grid-column:3}
.act{font:inherit;font-size:15px;font-weight:700;border-radius:10px;border:1.5px solid var(--line);background:#fff;padding:9px 11px;cursor:pointer;color:var(--ink2);min-width:58px}
.act.a1.on{background:var(--ok);border-color:var(--ok);color:#fff}
.act.a2.on{background:var(--stage);border-color:var(--stage);color:#fff}
.act.a3.on{background:var(--no);border-color:var(--no);color:#fff}
.empty{text-align:center;color:var(--muted);padding:40px 0}
/* bottom bar */
.bar{position:fixed;left:0;right:0;bottom:0;z-index:25;background:var(--card);border-top:1px solid var(--line);box-shadow:0 -4px 16px rgba(0,0,0,.06);padding:10px 12px calc(10px + env(safe-area-inset-bottom));display:flex;gap:10px;align-items:center}
.bar .now{flex:1;min-width:0;font-size:15px;color:var(--ink2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bar .now b{color:var(--navy);font-size:19px}
.bar .btn{background:var(--navy);color:#fff;padding:12px 18px;font-size:16px}
.bar .btn.sec{background:#efeadf;color:var(--navy)}
/* focus mode */
.modebtn.on{background:var(--gold);color:#fff}
.fz{max-width:760px;margin:0 auto}
.fz .lab{font-size:14px;color:var(--muted);letter-spacing:.15em;margin:4px 4px 8px}
.big{background:var(--card);border:2px solid var(--gold);border-radius:20px;padding:22px 24px;box-shadow:0 8px 24px rgba(184,137,43,.15)}
.big .award{display:inline-block;background:var(--navy);color:var(--gold2);border-radius:8px;padding:5px 12px;font-size:16px;font-weight:700;margin-bottom:12px}
.big .row1{display:flex;align-items:center;gap:18px}
.big .no{width:84px;height:84px;grid-row:auto}.big .no b{font-size:34px}
.big .name{font-size:46px}
.big .meta{font-size:18px;margin-top:6px}
.big .tags{margin-top:14px}.big .tag{font-size:15px;padding:5px 10px}
.bigacts{display:flex;gap:10px;margin-top:20px}
.bigacts button{font:inherit;font-weight:900;border:0;border-radius:14px;padding:18px;font-size:20px;cursor:pointer}
.go{flex:2;background:var(--stage);color:#fff}
.skip{flex:1;background:var(--nobg);color:var(--no)}
.undo{flex:1;background:#efeadf;color:var(--navy)}
.qline{display:flex;align-items:center;gap:12px;background:var(--card);border:1.5px solid var(--line);border-radius:12px;padding:10px 14px;margin-bottom:7px}
.qline .k{font-size:13px;color:var(--muted);width:46px}
.qline .nn{font-weight:900;font-size:20px}
.qline .sm{color:var(--ink2);font-size:14px}
.qline .newg{margin-left:auto;font-size:12px;background:var(--gold2);color:#6b4a0b;border-radius:6px;padding:2px 7px}
.qline.s1{border-left:6px solid var(--ok)}
/* modal */
.mask{position:fixed;inset:0;background:rgba(15,20,35,.5);z-index:40;display:none;align-items:center;justify-content:center;padding:20px}
.mask.show{display:flex}
.dlg{background:var(--card);border-radius:16px;max-width:420px;width:100%;padding:20px}
.dlg h3{margin:0 0 8px;font-size:20px}
.dlg p{color:var(--ink2);margin:0 0 16px;line-height:1.6}
.dlg .row{display:flex;gap:8px;justify-content:flex-end}
.legend{font-size:13px;color:var(--muted);margin:0 4px 10px;display:flex;gap:12px;flex-wrap:wrap}
.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:4px;vertical-align:-1px}
@media (max-width:640px){
  .card{grid-template-columns:52px 1fr}
  .no{width:48px;height:48px}.no b{font-size:19px}
  .acts{grid-column:1/3;grid-row:auto;order:5}
  .act{flex:1}
  .tags{grid-column:1/3}
  .name{font-size:23px}
  .stats{width:100%;margin-left:0}
}
</style>
</head>
