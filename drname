function card(d,pos){
  const s=st[d.no]||0;
  const m=d.name.match(/^(.*?)\((.*?)代\)?$/);
  const nm=m?`${esc(m[1])}<span class="proxy">${esc(m[2])} 代領</span>`:esc(d.name);
  const tags=[];
  tags.push(`<span class="tag seat">💺 ${esc(d.seat||'座位未定')}</span>`);
  const others=(byName[d.name]||[]).filter(x=>x.no!==d.no);
  if(others.length)tags.push(`<span class="tag rep" data-jump="${others[0].no}">🔁 另領：${others.map(x=>'#'+x.no+' '+esc(grpName(x.award))+rankOf(x.award)).join('、')}</span>`);
  if(d.note && !m)tags.push(`<span class="tag warn">⚠ ${esc(d.note)}</span>`);
  if(d.phone_survey && d.phone_survey!=='是')tags.push(`<span class="tag warn">☎ 出席：${esc(d.phone_survey)}</span>`);
  if(d.tel)tags.push(`<span class="tag tel">☏ ${esc(d.tel)}</span>`);
  return `<div class="card s${s}" id="p${d.no}">
    ${pos?`<span class="pos">本組第 ${pos} 位</span>`:''}
    <div class="no"><small>序號</small><b>${d.no}</b></div>
    <div class="who"><div class="name">${nm}</div>
      <div class="meta">${esc(d.dept)}・${esc(d.title)}${rankOf(d.award)?`・<span class="rank">${rankOf(d.award)}</span>`:''}${q?`・${esc(grpName(d.award))}`:''}</div></div>
    <div class="acts">
      <button class="act a1 ${s===1?'on':''}" data-no="${d.no}" data-s="1">排隊</button>
      <button class="act a2 ${s===2?'on':''}" data-no="${d.no}" data-s="2">上台</button>
      <button class="act a3 ${s===3?'on':''}" data-no="${d.no}" data-s="3">缺席</button>
    </div>
    <div class="tags">${tags.join('')}</div>
  </div>`;
}
